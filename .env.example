# === Root env example ===
# Скопируйте в .env и заполните значения.

# --- Postgres ---
POSTGRES_USER=zonaremonta
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=zonaremonta
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- API (apps/api) ---
API_PORT=4000
DATABASE_URL=postgresql://zonaremonta:change-me-strong@localhost:5432/zonaremonta?schema=public
REDIS_URL=redis://localhost:6379

# Секреты JWT — сгенерируйте `openssl rand -base64 48`
JWT_ACCESS_SECRET=replace-me-access
JWT_REFRESH_SECRET=replace-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# TOTP
TOTP_ISSUER=05auto

# SMS провайдеры
SMS_PROVIDER=smsc            # smsc | smsru | mock
SMSC_LOGIN=
SMSC_PASSWORD=
SMSRU_API_ID=

# Загрузки
UPLOADS_DIR=/var/lib/05auto/uploads
MAX_UPLOAD_MB=10

# CORS
CORS_ORIGINS=https://05auto.ru,http://localhost:3000

# Sentry
SENTRY_DSN=

# --- Web (apps/web) ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
NEXT_PUBLIC_SENTRY_DSN=

# Контакты (публичные)
NEXT_PUBLIC_PHONE=+79280000000
NEXT_PUBLIC_ADDRESS=г. Махачкала, ул. пример, 1
# WhatsApp — номер БЕЗ + и пробелов (для wa.me)
NEXT_PUBLIC_WHATSAPP=79280000000
# Max (мессенджер VK) — прямая ссылка
NEXT_PUBLIC_MAX=https://max.ru/05auto
# Ссылка на точку в Я.Картах
NEXT_PUBLIC_YANDEX_MAPS_LINK=https://yandex.ru/maps/?text=Махачкала%20Зона%20ремонта

# === АДМИНКА (вход в /admin/login) ===
# Используйте ТОЛЬКО буквы и цифры (без спецсимволов), чтобы не ломалось
# в shell/docker-compose при загрузке через --env-file.
# Изменили? Перезапустите: docker compose ... restart web
ADMIN_PASSWORD=20120505
# Случайная строка для подписи cookie. Сгенерировать: openssl rand -hex 32
ADMIN_SECRET=replace-me-with-32-plus-chars-random-string-please
